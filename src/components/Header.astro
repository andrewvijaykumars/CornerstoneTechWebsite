---
import { nav } from '../data/site';

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---
<header class="nav" id="top">
  <div class="nav__inner container">
    <a class="brand" href="/" aria-label="Cornerstone Tech Advisory home">
      <svg class="brand__mark" aria-hidden="true"><use href="#i-logo" /></svg>
      <span class="brand__text"><strong>Cornerstone</strong><small>Tech Advisory LLP</small></span>
    </a>
    <nav class="nav__links" id="nav-links" aria-label="Primary">
      <span class="nav__ink" aria-hidden="true"></span>
      {nav.map((l) => <a href={l.href} aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a>)}
      <a class="btn btn--sm btn--glow magnetic" href="/contact/"><span>Say hello</span></a>
    </nav>
    <button class="nav__toggle" type="button" aria-expanded="false" aria-controls="nav-links" aria-label="Open menu"><span></span><span></span></button>
  </div>
</header>
