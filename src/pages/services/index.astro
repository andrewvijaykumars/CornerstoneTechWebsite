---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import Cta from '../../components/Cta.astro';
import { services } from '../../data/services';
---
<Base
  title="Services"
  description="Twelve ways we help: honest advice, enterprise applications, customer experience, cloud, data, AI, custom apps, security, service management, connected systems, testing and ongoing care."
>
  <PageHero
    tag="How we can help"
    title="Everything you need,"
    accent="under one caring roof."
    lead="From the first honest conversation to software your people love using, and the care that continues long after launch."
    crumbs={[{ label: 'Services' }]}
  />
  <section class="container pb-section">
    <h2 class="sr-only">All service practices</h2>
    <div class="cards">
      {services.map((s, i) => <ServiceCard service={s} index={i} />)}
    </div>
  </section>
  <Cta />
</Base>
