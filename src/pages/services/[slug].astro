---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import Cta from '../../components/Cta.astro';
import Steps from '../../components/Steps.astro';
import Faq from '../../components/Faq.astro';
import { services, type Service } from '../../data/services';
import { site, firstMonth } from '../../data/site';

export function getStaticPaths() {
  return services.map((service, i) => ({
    params: { slug: service.slug },
    props: {
      service,
      prev: services[(i - 1 + services.length) % services.length],
      next: services[(i + 1) % services.length],
      related: [1, 2, 3].map((n) => services[(i + n) % services.length]),
    },
  }));
}

interface Props {
  service: Service;
  prev: Service;
  next: Service;
  related: Service[];
}
const { service, prev, next, related } = Astro.props;
const url = `${site.url}/services/${service.slug}/`;
const faqs = [
  { q: 'Do we need to know exactly what we want before we talk?', a: 'Not at all. Most conversations start with a feeling that something could be better. Helping you shape that into a clear plan is part of what we do.' },
  { q: `Which technologies do you use for ${service.title.toLowerCase()}?`, a: `We often work with ${service.tech.join(', ')}. That said, we always recommend what genuinely fits your people, budget and plans, even when the answer is simpler than expected.` },
  { q: 'Can you work alongside our own team or another supplier?', a: 'Yes, happily. We fit around the people you already have, share what we learn openly and leave your team more confident than before.' },
  { q: 'How do we begin?', a: `Write to ${site.email} with a few lines about what is on your mind. A real person replies, usually within one working day.` },
];
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: service.title,
    description: service.summary,
    url,
    provider: { '@type': 'Organization', name: site.name, url: site.url },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
      { '@type': 'ListItem', position: 2, name: 'Services', item: `${site.url}/services/` },
      { '@type': 'ListItem', position: 3, name: service.title, item: url },
    ],
  },
];
---
<Base title={service.title} description={service.summary} {schema}>
  <PageHero
    icon={service.icon}
    tag="Service practice"
    title={service.title}
    lead={service.summary}
    crumbs={[{ label: 'Services', href: '/services/' }, { label: service.title }]}
  />

  <section class="container pb-section">
    <div class="detail">
      <div>
        <section>
          <h2 class="reveal">In a nutshell</h2>
          <p class="section-lead reveal">{service.intro}</p>
        </section>
        <section>
          <h2 class="reveal">How we help</h2>
          <ul class="ticks">
            {service.capabilities.map((c) => <li class="reveal"><Icon name="check" />{c}</li>)}
          </ul>
        </section>
        <nav class="pager" aria-label="More services">
          <a class="spot reveal" href={`/services/${prev.slug}/`} rel="prev"><small>Previous</small><strong>{prev.title}</strong></a>
          <a class="spot reveal" href={`/services/${next.slug}/`} rel="next"><small>Next</small><strong>{next.title}</strong></a>
        </nav>
      </div>
      <aside class="aside">
        <div class="aside__box spot reveal">
          <h3>What you will feel</h3>
          <ul class="outcomes">
            {service.outcomes.map((o) => <li><Icon name="bolt" />{o}</li>)}
          </ul>
        </div>
        <div class="aside__box spot reveal">
          <h3>Technologies we use</h3>
          <div class="chips">{service.tech.map((t) => <span class="chip">{t}</span>)}</div>
        </div>
        <a class="btn btn--glow magnetic reveal" href="/contact/"><span>Let's talk about it</span><Icon name="arrow" /></a>
      </aside>
    </div>
  </section>

  <section class="container pb-section" aria-labelledby="month-title">
    <header class="section-head">
      <p class="section-tag reveal">What to expect</p>
      <h2 id="month-title" class="section-title" data-split>Your first month <span class="grad">with us.</span></h2>
      <p class="section-lead reveal">Every {service.title.toLowerCase()} journey starts the same calm way, so you always know what comes next.</p>
    </header>
    <Steps steps={firstMonth} label="Your first month" />
  </section>

  <section class="container pb-section" aria-labelledby="svc-faq-title">
    <header class="section-head section-head--center">
      <p class="section-tag reveal">Good questions</p>
      <h2 id="svc-faq-title" class="section-title" data-split>Before you <span class="grad">write to us.</span></h2>
    </header>
    <Faq items={faqs} id="svc-faq" />
  </section>

  <section class="container pb-section">
    <header class="section-head">
      <p class="section-tag reveal">Related</p>
      <h2 class="section-title" data-split>Explore more practices</h2>
    </header>
    <div class="cards cards--3">
      {related.map((s) => <ServiceCard service={s} />)}
    </div>
  </section>
  <Cta />
</Base>
