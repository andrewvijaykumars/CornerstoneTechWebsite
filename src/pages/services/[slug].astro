---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import Cta from '../../components/Cta.astro';
import { services, type Service } from '../../data/services';
import { site } from '../../data/site';

export function getStaticPaths() {
  return services.map((service, i) => ({
    params: { slug: service.slug },
    props: {
      service,
      prev: services[(i - 1 + services.length) % services.length],
      next: services[(i + 1) % services.length],
      related: [1, 2, 3].map((n) => services[(i + n) % services.length]),
    },
  }));
}

interface Props {
  service: Service;
  prev: Service;
  next: Service;
  related: Service[];
}
const { service, prev, next, related } = Astro.props;
const url = `${site.url}/services/${service.slug}/`;
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: service.title,
    description: service.summary,
    url,
    provider: { '@type': 'Organization', name: site.name, url: site.url },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
      { '@type': 'ListItem', position: 2, name: 'Services', item: `${site.url}/services/` },
      { '@type': 'ListItem', position: 3, name: service.title, item: url },
    ],
  },
];
---
<Base title={service.title} description={service.summary} {schema}>
  <PageHero
    icon={service.icon}
    tag="Service practice"
    title={service.title}
    lead={service.summary}
    crumbs={[{ label: 'Services', href: '/services/' }, { label: service.title }]}
  />

  <section class="container pb-section">
    <div class="detail">
      <div>
        <section>
          <h2 class="reveal">In a nutshell</h2>
          <p class="section-lead reveal">{service.intro}</p>
        </section>
        <section>
          <h2 class="reveal">How we help</h2>
          <ul class="ticks">
            {service.capabilities.map((c) => <li class="reveal"><Icon name="check" />{c}</li>)}
          </ul>
        </section>
        <nav class="pager" aria-label="More services">
          <a class="spot reveal" href={`/services/${prev.slug}/`} rel="prev"><small>Previous</small><strong>{prev.title}</strong></a>
          <a class="spot reveal" href={`/services/${next.slug}/`} rel="next"><small>Next</small><strong>{next.title}</strong></a>
        </nav>
      </div>
      <aside class="aside">
        <div class="aside__box spot reveal">
          <h3>What you will feel</h3>
          <ul class="outcomes">
            {service.outcomes.map((o) => <li><Icon name="bolt" />{o}</li>)}
          </ul>
        </div>
        <div class="aside__box spot reveal">
          <h3>Technologies we use</h3>
          <div class="chips">{service.tech.map((t) => <span class="chip">{t}</span>)}</div>
        </div>
        <a class="btn btn--glow magnetic reveal" href="/contact/"><span>Let's talk about it</span><Icon name="arrow" /></a>
      </aside>
    </div>
  </section>

  <section class="container pb-section">
    <header class="section-head">
      <p class="section-tag reveal">Related</p>
      <h2 class="section-title" data-split>Explore more practices</h2>
    </header>
    <div class="cards cards--3">
      {related.map((s) => <ServiceCard service={s} />)}
    </div>
  </section>
  <Cta />
</Base>
