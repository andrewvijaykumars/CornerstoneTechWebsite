---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import Steps from '../components/Steps.astro';
import { site, afterYouWrite } from '../data/site';

const d = site.details;
const hasDetails = Boolean(d.address || d.phone || d.linkedin || d.llpin);

const tips = [
  { icon: 'heart', title: 'What is on your mind', text: 'The challenge, the hope or simply the question. There is no wrong way to start.' },
  { icon: 'users', title: 'Who it is for', text: 'The people you are trying to help, and the team that will work with us.' },
  { icon: 'compass', title: 'When it matters', text: 'Any dates or milestones, so we can plan around what is important to you.' },
];
---
<Base hideDock title="Contact" description={`Write to Cornerstone Tech Advisory LLP at ${site.email}. A real person reads every message and usually replies within one working day.`}>
  <PageHero
    tag="Contact"
    title="Let's start with"
    accent="a conversation."
    lead="No forms and no scripts. Just write to us, the way you would write to a friend who happens to know technology."
    crumbs={[{ label: 'Contact' }]}
  />

  <section class="container pb-section">
    <article class="letter spot glow-edge reveal">
      <div class="letter__aura" aria-hidden="true"></div>
      <Icon name="mail" class="letter__icon" />
      <p class="letter__label">Write to us at</p>
      <a class="letter__email email-line" href={`mailto:${site.email}`}>{site.email}</a>
      <p class="letter__text">A real person reads every message. We usually reply within one working day, and we are always happy to start with a relaxed, no-obligation chat.</p>
      <div class="letter__actions">
        <a class="btn btn--glow magnetic" href={`mailto:${site.email}?subject=${encodeURIComponent('Hello Cornerstone')}`}><span>Write an email</span><Icon name="arrow" /></a>
        <button class="btn btn--ghost" type="button" data-copy={site.email}><span>Copy address</span></button>
      </div>
    </article>

    <div class="detail-block">
      <header class="section-head section-head--center">
        <p class="section-tag reveal">What happens next</p>
        <h2 class="section-title" data-split>After you <span class="grad">press send.</span></h2>
      </header>
      <Steps steps={afterYouWrite} label="What happens after you write" />
    </div>

    <div class="tips detail-block">
      <header class="section-head section-head--center">
        <p class="section-tag reveal">If it helps</p>
        <h2 class="section-title" data-split>A few things you <span class="grad">might mention.</span></h2>
      </header>
      <ul class="values">
        {tips.map((t) => (
          <li class="value spot reveal"><Icon name={t.icon} /><h3>{t.title}</h3><p>{t.text}</p></li>
        ))}
      </ul>
    </div>

    {hasDetails && (
      <ul class="detail-list spot reveal">
        {d.address && <li><Icon name="pin" /><span>{d.address}</span></li>}
        {d.phone && <li><Icon name="phone" /><a href={`tel:${d.phone.replace(/\s/g, '')}`}>{d.phone}</a></li>}
        {d.linkedin && <li><Icon name="linkedin" /><a href={d.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a></li>}
        {d.llpin && <li><Icon name="building" /><span>LLPIN {d.llpin}</span></li>}
      </ul>
    )}
  </section>
</Base>
