---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import Cta from '../components/Cta.astro';
import { process, why } from '../data/site';

const values = [
  { icon: 'compass', title: 'Clarity first', text: 'We start by understanding the business problem, then choose technology that serves it, not the other way round.' },
  { icon: 'users', title: 'Partnership', text: 'We work as an extension of your team, with open communication and shared accountability for outcomes.' },
  { icon: 'shield', title: 'Integrity', text: 'Honest advice, transparent delivery and respect for your data, your people and your confidentiality.' },
  { icon: 'spark', title: 'Craft', text: 'We care about the quality of what we build: clean architecture, rigorous testing and thoughtful design.' },
];
---
<Base title="About" description="Cornerstone Tech Advisory LLP is a software consulting partner that combines advisory thinking with hands-on engineering across every industry.">
  <PageHero
    tag="About us"
    title="A software consulting partner for"
    accent="ambitious organisations."
    lead="We combine sharp advisory thinking with hands-on engineering to design, build and run the platforms that power modern business."
    crumbs={[{ label: 'About' }]}
  />

  <section class="section container">
    <div class="split-2">
      <div>
        <p class="section-tag reveal">Our mission</p>
        <h2 class="section-title" data-split>The foundation your digital future is built on.</h2>
        <div class="copy reveal">
          <p>A cornerstone is the first stone set in a building. Every other stone is positioned in relation to it. We chose the name because that is the role we aim to play: the solid, dependable base for the technology decisions that follow.</p>
          <p>Cornerstone Tech Advisory LLP works on the software products that are most in demand across industries and domains, from enterprise platforms and cloud to data, AI and custom engineering.</p>
        </div>
      </div>
      <div class="orbit reveal" aria-hidden="true">
        <div class="orbit__ring"><i></i></div>
        <div class="orbit__ring"><i></i></div>
        <div class="orbit__ring"><i></i></div>
        <svg class="orbit__core"><use href="#i-logo" /></svg>
      </div>
    </div>
  </section>

  <section class="section container">
    <header class="section-head">
      <p class="section-tag reveal">Values</p>
      <h2 class="section-title" data-split>What we <span class="grad">stand for.</span></h2>
    </header>
    <div class="values">
      {values.map((v) => (
        <article class="value spot reveal"><Icon name={v.icon} /><h3>{v.title}</h3><p>{v.text}</p></article>
      ))}
    </div>
  </section>

  <section class="section container why">
    <div class="why__intro">
      <p class="section-tag reveal">How we work</p>
      <h2 class="section-title" data-split>Built on trust. <span class="grad">Engineered for outcomes.</span></h2>
      <p class="section-lead reveal">Our delivery follows five clear stages: {process.map((p) => p.title).join(', ')}. Senior people stay involved throughout.</p>
    </div>
    <ul class="why__list">
      {why.map((w) => (
        <li class="spot reveal"><Icon name={w.icon} /><div><h3>{w.title}</h3><p>{w.text}</p></div></li>
      ))}
    </ul>
  </section>

  <Cta title="Let's talk about your next platform." />
</Base>
