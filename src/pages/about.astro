---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import Cta from '../components/Cta.astro';
import Purpose from '../components/Purpose.astro';
import { chapters, promises } from '../data/site';

const values = [
  { icon: 'ear', title: 'Listen first', text: 'Every good solution starts with understanding the people it is for. So we ask, we listen, and then we listen a little more.' },
  { icon: 'heart', title: 'Lead with empathy', text: 'Change can feel unsettling. We are patient, we explain things simply, and we never make anyone feel left behind.' },
  { icon: 'shield', title: 'Always honest', text: 'We tell you what we really think, even when the honest answer is the simpler one or not what you expected.' },
  { icon: 'spark', title: 'Care for the craft', text: 'We take pride in the details: thoughtful design, careful engineering and testing that catches problems early.' },
];
---
<Base title="About" description="Cornerstone Tech Advisory LLP is a technology partner that listens first, explains things simply and builds software with genuine care for the people who use it.">
  <PageHero
    tag="About us"
    title="People who care about"
    accent="people."
    lead="We are technologists who believe the best software is built by listening closely, speaking plainly and caring deeply about the people on the other side of the screen."
    crumbs={[{ label: 'About' }]}
  />

  <section class="section container">
    <div class="split-2">
      <div>
        <p class="section-tag reveal">Why "Cornerstone"</p>
        <h2 class="section-title" data-split>The first stone, <span class="grad">set with care.</span></h2>
        <div class="copy reveal">
          <p>A cornerstone is the first stone laid in a building. Every other stone is placed in relation to it, so it has to be true, steady and made to last.</p>
          <p>That is the role we hope to play for you: a steady, trustworthy foundation for the decisions that follow, and a friendly face you can rely on for years to come.</p>
        </div>
      </div>
      <div class="orbit reveal" aria-hidden="true">
        <div class="orbit__ring"><i></i></div>
        <div class="orbit__ring"><i></i></div>
        <div class="orbit__ring"><i></i></div>
        <svg class="orbit__core"><use href="#i-logo" /></svg>
      </div>
    </div>
  </section>

  <Purpose full />

  <section class="section container">
    <header class="section-head">
      <p class="section-tag reveal">What we stand for</p>
      <h2 class="section-title" data-split>Values you can <span class="grad">feel.</span></h2>
    </header>
    <div class="values">
      {values.map((v) => (
        <article class="value spot glow-edge reveal"><Icon name={v.icon} /><h3>{v.title}</h3><p>{v.text}</p></article>
      ))}
    </div>
  </section>

  <section class="section container why">
    <div class="why__intro">
      <p class="section-tag reveal">How we work</p>
      <h2 class="section-title" data-split>Built on trust. <span class="grad">Grown with care.</span></h2>
      <p class="section-lead reveal">Every project follows the same simple rhythm: {chapters.map((c) => c.title.toLowerCase()).join(', ')}. The same people stay with you throughout.</p>
    </div>
    <ul class="why__list">
      {promises.map((w) => (
        <li class="spot reveal"><Icon name={w.icon} /><div><h3>{w.title}</h3><p>{w.text}</p></div></li>
      ))}
    </ul>
  </section>

  <Cta />
</Base>
