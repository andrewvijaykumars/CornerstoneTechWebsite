---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import Cta from '../../components/Cta.astro';
import { industries, type Industry } from '../../data/industries';
import { services } from '../../data/services';
import { site } from '../../data/site';

export function getStaticPaths() {
  return industries.map((industry, i) => ({
    params: { slug: industry.slug },
    props: {
      industry,
      prev: industries[(i - 1 + industries.length) % industries.length],
      next: industries[(i + 1) % industries.length],
    },
  }));
}

interface Props {
  industry: Industry;
  prev: Industry;
  next: Industry;
}
const { industry, prev, next } = Astro.props;
const url = `${site.url}/industries/${industry.slug}/`;
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
      { '@type': 'ListItem', position: 2, name: 'Industries', item: `${site.url}/industries/` },
      { '@type': 'ListItem', position: 3, name: industry.title, item: url },
    ],
  },
];
const featured = services.filter((s) => ['enterprise-applications', 'cloud-devops', 'data-analytics-bi', 'ai-genai-automation'].includes(s.slug));
---
<Base title={industry.title} description={industry.summary} {schema}>
  <PageHero
    icon={industry.icon}
    tag="Industry"
    title={industry.title}
    lead={industry.summary}
    crumbs={[{ label: 'Industries', href: '/industries/' }, { label: industry.title }]}
  />

  <section class="container pb-section">
    <div class="detail">
      <div>
        <section>
          <h2 class="reveal">How we see it</h2>
          <p class="section-lead reveal">{industry.intro}</p>
        </section>
        <section>
          <h2 class="reveal">How we can help</h2>
          <ul class="ticks">
            {industry.solutions.map((c) => <li class="reveal"><Icon name="check" />{c}</li>)}
          </ul>
        </section>
        <section>
          <h2 class="reveal">Ways we often help</h2>
          <ul class="ticks">
            {featured.map((s) => <li class="reveal"><Icon name={s.icon} /><a href={`/services/${s.slug}/`}>{s.title}</a></li>)}
          </ul>
        </section>
        <nav class="pager" aria-label="More industries">
          <a class="spot reveal" href={`/industries/${prev.slug}/`} rel="prev"><small>Previous</small><strong>{prev.title}</strong></a>
          <a class="spot reveal" href={`/industries/${next.slug}/`} rel="next"><small>Next</small><strong>{next.title}</strong></a>
        </nav>
      </div>
      <aside class="aside">
        <div class="aside__box spot reveal">
          <h3>What matters most</h3>
          <ul class="outcomes">
            {industry.focus.map((o) => <li><Icon name="bolt" />{o}</li>)}
          </ul>
        </div>
        <div class="aside__box spot reveal">
          <h3>Technologies we often use</h3>
          <div class="chips">{industry.platforms.map((t) => <span class="chip">{t}</span>)}</div>
        </div>
        <a class="btn btn--glow magnetic reveal" href="/contact/"><span>Share your story</span><Icon name="arrow" /></a>
      </aside>
    </div>
  </section>
  <Cta />
</Base>
