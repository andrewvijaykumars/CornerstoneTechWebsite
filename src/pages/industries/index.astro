---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import Cta from '../../components/Cta.astro';
import { industries } from '../../data/industries';
---
<Base
  title="Industries"
  description="We take the time to understand your world: banking, insurance, healthcare, retail, manufacturing, energy, telecom, logistics, public services, education, travel and mobility."
>
  <PageHero
    tag="Industries"
    title="We speak your world's"
    accent="language."
    lead="Every field has its own pressures, people and promises. We take the time to understand yours before we suggest a single thing."
    crumbs={[{ label: 'Industries' }]}
  />
  <section class="container pb-section">
    <h2 class="sr-only">All industries</h2>
    <div class="cards">
      {industries.map((ind, i) => (
        <article class="card spot tilt reveal">
          <div class="card__glare"></div>
          <span class="card__num">{String(i + 1).padStart(2, '0')}</span>
          <Icon name={ind.icon} class="card__icon" />
          <h3>{ind.title}</h3>
          <p>{ind.summary}</p>
          <a class="link-arrow" href={`/industries/${ind.slug}/`} aria-label={`See how we help: ${ind.title}`}>See how we help <Icon name="arrow" /></a>
        </article>
      ))}
    </div>
  </section>
  <Cta />
</Base>
