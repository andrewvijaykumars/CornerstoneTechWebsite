---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import Cta from '../../components/Cta.astro';
import { industries } from '../../data/industries';
---
<Base
  title="Industries"
  description="Domain depth across banking, insurance, healthcare, retail, manufacturing, energy, telecom, logistics, public sector, education, travel and automotive."
>
  <PageHero
    tag="Industries"
    title="Domain depth across"
    accent="every sector."
    lead="Technology is only valuable when it understands the business it serves. We pair platform expertise with deep industry context."
    crumbs={[{ label: 'Industries' }]}
  />
  <section class="container pb-section">
    <h2 class="sr-only">All industries</h2>
    <div class="cards">
      {industries.map((ind, i) => (
        <article class="card spot tilt reveal">
          <div class="card__glare"></div>
          <span class="card__num">{String(i + 1).padStart(2, '0')}</span>
          <Icon name={ind.icon} class="card__icon" />
          <h3>{ind.title}</h3>
          <p>{ind.summary}</p>
          <a class="link-arrow" href={`/industries/${ind.slug}/`} aria-label={`View industry: ${ind.title}`}>View industry <Icon name="arrow" /></a>
        </article>
      ))}
    </div>
  </section>
  <Cta />
</Base>
