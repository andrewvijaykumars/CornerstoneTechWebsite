---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---
<Base title="Page not found" noindex>
  <section class="notfound">
    <p class="notfound__code grad" aria-hidden="true">404</p>
    <h1 class="section-title">Oops, this page wandered off.</h1>
    <p class="section-lead">It happens to the best of us. Let's get you back somewhere familiar.</p>
    <a class="btn btn--glow magnetic" href="/"><span>Back to home</span><Icon name="arrow" /></a>
    <nav class="notfound__links" aria-label="Popular pages">
      <a href="/services/">Ways we help</a>
      <a href="/industries/">Industries</a>
      <a href="/about/#purpose">Our purpose</a>
      <a href="/contact/">Contact</a>
    </nav>
  </section>
</Base>
