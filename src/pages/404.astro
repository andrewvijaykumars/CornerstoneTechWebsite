---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---
<Base title="Page not found" noindex>
  <section class="notfound">
    <p class="notfound__code grad" aria-hidden="true">404</p>
    <h1 class="section-title">This page took a wrong turn.</h1>
    <p class="section-lead">The page you are looking for does not exist or has moved.</p>
    <a class="btn btn--glow magnetic" href="/"><span>Back to home</span><Icon name="arrow" /></a>
  </section>
</Base>
